{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(gh issue *)",
      "Bash(gh api *)",
      "Bash(gh run *)",
      "Bash(gh workflow *)",
      "Bash(gh label *)",
      "Bash(gh secret *)",
      "Bash(zsh -n *)",
      "Bash(bin/dotfiles-doctor)",
      "Bash(bash scripts/doctor/*)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:cafe.github.com)"
    ]
  }
}
